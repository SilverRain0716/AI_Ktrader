# AI_Ktrader 스케줄 예시 — `crontab -e` 에 붙여 쓴다.
#
# **cron 은 저장소 밖이다.** 여기 있는 것은 예시이고, 실제로 도는 것은 사용자 crontab 이다.
# 그래서 "스케줄을 바꿨는데 안 도는" 사고가 나기 쉽다 — 바꾸면 `crontab -l` 로 확인한다.
#
# 러너가 시각을 다시 검사하지 않는다(--cycle 을 명시하므로). cron 이 늦으면 늦은 대로 돈다.
# 대신 **락**이 중복을 막고, **킬 스위치**가 전체를 멈춘다.
#
# 주의: cron 은 PATH·환경변수가 거의 없다. 절대경로를 쓰고 .env 는 python-dotenv 가 읽는다.

SHELL=/bin/bash
AIK=/home/silverrain/projects/AI_Ktrader

# **시간대를 명시한다.** 셸이 KST 라고 cron 도 KST 인 것은 아니다 — 데몬이 UTC 로
# 돌면 `20 8` 이 한국시간 17:20 이 되어 **프리마켓 사이클이 장 마감 후에 돈다.**
# 이 줄이 없으면 시각이 9시간 어긋나도 로그만 보고는 알 수 없다.
# (cron 구현에 따라 무시될 수 있다 — 등록 뒤 `logs/cron.log` 의 첫 실행 시각을 확인한다.)
CRON_TZ=Asia/Seoul
TZ=Asia/Seoul

# 판단은 **하루 두 번**이다 (2026-09-08). 8거래일 실적으로 줄였다:
#
#   premarket  판단 20 · 매수 23 · $4.12  → 매수당 $0.18
#   midday     판단 23 · 매수  7 · $4.48  → 매수당 $0.64 (3.5배)
#   preclose   **한 번도 안 돌았다** — 15:00 결정은 valid_until 15:20 이라
#              사람이 20분 안에 place 를 쳐야 한다. 현실적으로 안 된다
#
# 그리고 이것은 스윙이다 — 하루치 움직임은 손절선까지 거리의 1/7 이하이고,
# 장중 급변은 판단을 다시 부르는 것이 아니라 `protect`(손절선)와
# `invalidation` 감시가 맡는다. midday·preclose 는 손으로 부를 수 있다:
#   .venv/bin/python -m ops.runner --cycle midday

# 전날 미결 주문 체결 판정 — **premarket 보다 먼저**여야 그날 판단이 실제 보유를 본다.
10  8 * * 1-5  cd $AIK && .venv/bin/python -m gate.pipeline settle          >> logs/cron.log 2>&1

# 어제 보고서 — 체결 판정 뒤라야 "나가지 않은 주문"이 제대로 보인다.
15  8 * * 1-5  cd $AIK && .venv/bin/python -m ops.report                    >> logs/report.log 2>&1

# 판단 1 — **개장 직후**. 08:20 은 넥스트레이드(08:00~)가 도는데도 장중 시세를
# 못 봐서 전 거래일 종가로만 판단했다.
 0  9 * * 1-5  cd $AIK && .venv/bin/python -m ops.runner --cycle premarket  >> logs/cron.log 2>&1

# 장 마감 후 데이터 배치. postmarket 판단보다 **먼저** 와야 한다.
 0 18 * * 1-5  cd $AIK && .venv/bin/python -m ops.runner --cycle data       >> logs/cron.log 2>&1

# 판단 2 — 그날 종가로 복기.
30 18 * * 1-5  cd $AIK && .venv/bin/python -m ops.runner --cycle postmarket >> logs/cron.log 2>&1
