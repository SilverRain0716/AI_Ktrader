{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SilverRain0716/AI_Ktrader/main/schemas/decision.schema.json",
  "title": "AI 판단 결과 (모델 출력)",
  "description": "AI 판단 엔진의 유일한 출력 형식. 자유 텍스트는 받지 않는다. 이 스키마를 통과하지 못한 출력은 전체를 거부하고 재요청한다 — 부분 파싱하지 않는다. 이 스키마는 **모델이 내는 것만** 정의한다: decision_id(멱등키)·pack_id·arm·model·타임스탬프는 러너가 봉인한다(ADR 0007 결정 3). 구조화 출력(output_config.format)에 그대로 넘길 수 있도록 모든 객체가 additionalProperties=false 이고 모든 속성이 required 다 — 선택 필드는 null 을 허용하는 방식으로 표현한다. action 별 필수 조건(BUY/ADD 는 손절이 있어야 한다 등)은 스키마가 아니라 decision/contract.py 의 action_requirements() 가 강제한다. if/then 조건부 검증은 strict 구조화 출력이 지원하지 않기 때문이고, 그 규칙을 잃지 않기 위해 코드로 옮긴 것이다.",
  "type": "object",
  "required": [
    "market_view",
    "abstain",
    "abstain_reason",
    "decisions",
    "portfolio_note",
    "data_concerns"
  ],
  "additionalProperties": false,
  "properties": {
    "market_view": {
      "type": "string",
      "maxLength": 1200,
      "description": "오늘 시장에 대한 종합 판단 한 문단. 개별 종목 결정의 전제."
    },
    "abstain": {
      "type": "boolean",
      "description": "true면 신규 진입을 하지 않는다. 근거 있는 후보가 없을 때 반드시 이 값을 쓴다 — 자리를 채우기 위해 근거가 약한 종목을 넣지 않는다. **이것은 판단의 결과이지 장애가 아니다.** API 장애·타임아웃·스키마 위반은 러너가 status 로 따로 기록한다(ADR 0007) — 관측과 결측을 섞으면 F2·F3 표본이 오염된다."
    },
    "abstain_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600,
      "description": "abstain 이 true 일 때 그 이유. false 면 null."
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "portfolio_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 900,
      "description": "포트폴리오 전체 관점. 예: 'A 진입을 위해 B를 먼저 축소', '섹터 집중도가 한도에 근접'. 없으면 null."
    },
    "data_concerns": {
      "type": "array",
      "maxItems": 10,
      "description": "입력 데이터에서 발견한 문제. 비어 있지 않으면 실행 계층이 신뢰도를 낮춘다.",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "$defs": {
    "stockCode": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "code",
        "name",
        "weight_pct",
        "entry",
        "stop",
        "target",
        "trail",
        "max_hold_days",
        "confidence",
        "reasons",
        "invalidation",
        "briefing_refs",
        "sources"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "BUY",
            "ADD",
            "HOLD",
            "TRIM",
            "EXIT"
          ],
          "description": "BUY=신규 진입 / ADD=추가 매수 / HOLD=유지 / TRIM=일부 축소 / EXIT=전량 청산"
        },
        "code": {
          "$ref": "#/$defs/stockCode"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "참고용. **러너가 listing 기준으로 덮어쓴다 — code 가 진실이다.**"
        },
        "weight_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "BUY/ADD: 목표 비중. TRIM: 축소 후 남길 비중. HOLD/EXIT: null"
        },
        "entry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type",
            "price",
            "condition",
            "valid_until"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "MARKET",
                "LIMIT",
                "COND"
              ]
            },
            "price": {
              "type": [
                "integer",
                "null"
              ],
              "description": "LIMIT 일 때 지정가(원). MARKET·COND 는 null."
            },
            "condition": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200,
              "description": "COND 일 때만. 실행 계층이 감시할 수 있는 형태여야 한다. 예: '시가 대비 -1.0% 이하 터치'"
            },
            "valid_until": {
              "type": [
                "string",
                "null"
              ],
              "description": "이 진입 지시가 유효한 마지막 시각 (ISO 8601). 없으면 null 이고 결정의 valid_until 을 따른다."
            }
          },
          "description": "BUY/ADD 에서만 채운다. 나머지는 null."
        },
        "stop": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ATR",
                "PCT",
                "PRICE"
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "description": "손절 기준. ATR 배수를 권장한다 — 고정 %는 변동성 큰 종목에서 노이즈에 털리고 작은 종목에서 늦게 잘린다. **BUY/ADD 는 null 일 수 없다**(contract.action_requirements)."
        },
        "target": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ATR",
                "PCT",
                "PRICE"
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "description": "목표가. 없으면 null."
        },
        "trail": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "activation_pct",
            "drop_pct"
          ],
          "properties": {
            "activation_pct": {
              "type": "number"
            },
            "drop_pct": {
              "type": "number"
            }
          },
          "description": "트레일링 스탑. 없으면 null."
        },
        "max_hold_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 30
        },
        "confidence": {
          "type": "string",
          "enum": [
            "상",
            "중상",
            "중",
            "하"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "description": "확인된 사실 2개 이상. 정량 지표와 브리핑 근거를 각각 명시한다. '테마 강세', '많이 올랐다'는 근거가 아니다.",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "invalidation": {
          "type": "object",
          "additionalProperties": false,
          "description": "이 판단이 틀렸음을 알 수 있는 반증 가능한 단일 사건. **자유 문장이 아니라 구조로 받는다** — 실행 계층이 감시 조건으로 등록해야 하는데(ADR 0003 원칙 4) '주가가 빠지면' 같은 문장은 기계가 영원히 감시할 수 없기 때문이다. 양방향 서술('A 또는 반대로 B')은 type 이 하나뿐이므로 구조가 막는다.",
          "required": [
            "type",
            "value",
            "deadline",
            "text"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "price_below",
                "close_below_ma",
                "disclosure_category",
                "stance_reversal",
                "unstructured"
              ],
              "description": "price_below=지정가 하회 / close_below_ma=종가가 이동평균선 하회 / disclosure_category=특정 유형 공시 발생 / stance_reversal=브리핑 관점 반전 / unstructured=위 넷으로 표현할 수 없다. **unstructured 는 감시되지 않는다** — 러너가 monitorable=false 로 기록하고, 그 비율이 높아지면 enum 을 재검토한다."
            },
            "value": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "description": "price_below=가격(원) / close_below_ma=이동평균 기간(20, 60) / disclosure_category=공시 유형 문자열 / stance_reversal·unstructured=null"
            },
            "deadline": {
              "type": [
                "string",
                "null"
              ],
              "description": "이 조건을 감시할 마지막 날 (YYYY-MM-DD). 없으면 null 이고, 그때는 max_hold_days 가 사실상의 기한이 된다."
            },
            "text": {
              "type": "string",
              "maxLength": 300,
              "description": "사람이 읽는 근거. 구조화된 필드를 대체하지 않고 병기한다."
            }
          }
        },
        "briefing_refs": {
          "type": "array",
          "maxItems": 10,
          "description": "근거로 삼은 브리핑 id. 브리핑 근거 없이 정량만으로 판단했다면 빈 배열. **Arm 2 응답에서 비어 있지 않으면 파생 누수다**(ADR 0007 근거 3).",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
