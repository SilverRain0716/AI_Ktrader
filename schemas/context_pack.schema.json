{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SilverRain0716/AI_Ktrader/main/schemas/context_pack.schema.json",
  "title": "컨텍스트 팩",
  "description": "AI 판단 엔진의 단일 입력. 정량 지표 + 브리핑 + 계좌·포지션 + 제약을 한 덩어리로 묶는다. AI는 이것 외의 상태를 알지 못한다 — 여기 없는 정보는 판단에 반영되지 않는다.",
  "type": "object",
  "required": [
    "pack_id",
    "generated_at",
    "cycle",
    "account",
    "positions",
    "constraints",
    "universe"
  ],
  "additionalProperties": false,
  "properties": {
    "pack_id": {
      "type": "string",
      "description": "YYYYMMDD-HHMM-cycle 형식"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cycle": {
      "type": "string",
      "enum": [
        "premarket",
        "midday",
        "preclose",
        "postmarket",
        "event"
      ],
      "description": "premarket 08:20 / midday 12:20 / preclose 15:00 / postmarket 18:30 / event=무효화 조건 트리거"
    },
    "event_trigger": {
      "type": "object",
      "description": "cycle이 event일 때만 채운다.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "invalidation_hit",
            "vi_triggered",
            "stop_approach",
            "condition_search_entry",
            "disclosure",
            "index_shock"
          ]
        },
        "code": {
          "$ref": "#/$defs/stockCode"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "market": {
      "type": "object",
      "description": "시장 상태. 브리핑 값이 아니라 데이터 계층이 직접 계산한 값을 쓴다.",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string",
          "enum": [
            "CLOSED",
            "PRE",
            "REGULAR",
            "AUCTION",
            "POST"
          ]
        },
        "kospi": {
          "$ref": "#/$defs/indexState"
        },
        "kosdaq": {
          "$ref": "#/$defs/indexState"
        },
        "usdkrw": {
          "type": "number"
        },
        "us_overnight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sp500_pct": {
              "type": "number"
            },
            "nasdaq_pct": {
              "type": "number"
            },
            "sox_pct": {
              "type": "number"
            },
            "futures_pct": {
              "type": "number"
            }
          }
        },
        "sector_returns": {
          "type": "object",
          "description": "KRX 업종지수 등락률. 키=업종명, 값=%",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "account": {
      "type": "object",
      "required": [
        "total_equity_krw",
        "cash_available_krw"
      ],
      "additionalProperties": false,
      "properties": {
        "total_equity_krw": {
          "type": "integer",
          "description": "예수금 + 보유 평가금. 시드가 아니라 파생값이므로 하한을 두지 않는다"
        },
        "cash_available_krw": {
          "type": "integer",
          "description": "미체결·주문잠금 차감 후 실제 가용액"
        },
        "realized_pnl_today_krw": {
          "type": "integer"
        },
        "unrealized_pnl_krw": {
          "type": "integer"
        },
        "is_mock": {
          "type": "boolean"
        }
      }
    },
    "positions": {
      "type": "array",
      "description": "현재 보유 종목. AI는 이걸 보고 유지·축소·청산을 판단한다.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "qty",
          "avg_price",
          "current_price",
          "net_yield_pct",
          "held_days"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/stockCode"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty": {
            "type": "integer"
          },
          "avg_price": {
            "type": "integer"
          },
          "current_price": {
            "type": "integer"
          },
          "net_yield_pct": {
            "type": "number",
            "description": "수수료·거래세 차감 후 순수익률. 총수익률과 혼동 금지."
          },
          "high_since_entry": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "weight_pct": {
            "type": "number",
            "description": "총자산 대비 비중"
          },
          "held_days": {
            "type": "integer"
          },
          "entry_decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "이 포지션을 만든 결정의 id"
          },
          "entry_thesis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "진입 당시 근거. 이게 아직 유효한지가 보유 판단의 핵심."
          },
          "invalidation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "진입 시 설정한 무효화 조건"
          },
          "invalidation_hit": {
            "type": "boolean"
          },
          "stop_price": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_price": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_hold_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "indicators": {
            "$ref": "#/$defs/indicators"
          },
          "spot": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "price",
              "change_pct",
              "as_of"
            ],
            "description": "**지금 이 순간의 값.** `indicators` 는 전 거래일 종가 기준이고 여기만 장중이다. 둘을 한 문장에 섞어 말하지 마라. 장중 시세를 못 받았으면 null 이다.",
            "properties": {
              "price": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "change_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "KST ISO8601"
              }
            }
          }
        }
      }
    },
    "universe": {
      "type": "array",
      "description": "정량 스크리닝을 통과한 후보. AI는 이 안에서만 신규 진입을 고를 수 있다(환각 방지). 제외 사유가 있는 종목은 애초에 여기 들어오지 않는다.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "indicators",
          "tradable"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/stockCode"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "KOSPI",
              "KOSDAQ"
            ]
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "업종 대분류. 섹터 집중도 한도는 이 값으로 판정한다. 분류 불명이면 null. 목적은 '같이 움직이는 종목에 몰리지 않는 것'이므로, '기타'가 크면 한도가 무의미해진다."
          },
          "indicators": {
            "$ref": "#/$defs/indicators",
            "description": "**전 거래일 종가 기준이다.** 장중이라도 여기 값은 어제 것이다 — 지금 값은 `spot` 에 있다."
          },
          "spot": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "price",
              "change_pct",
              "as_of"
            ],
            "description": "**지금 이 순간의 값.** `indicators` 는 전 거래일 종가 기준이고 여기만 장중이다. 둘을 한 문장에 섞어 말하지 마라. 장중 시세를 못 받았으면 null 이다.",
            "properties": {
              "price": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "change_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "KST ISO8601"
              }
            }
          },
          "flows": {
            "$ref": "#/$defs/stockFlows"
          },
          "tradable": {
            "type": "boolean",
            "description": "거래정지·관리종목·정리매매·투자위험이 아니면 true"
          },
          "screen_reasons": {
            "type": "array",
            "description": "이 종목이 유니버스에 든 이유. 어느 채널(briefing/momentum/flow)로 들어왔는지 반드시 포함한다 — AI가 '수급으로 올라왔지만 브리핑 근거는 없다'를 구분할 수 있어야 한다.",
            "items": {
              "type": "string"
            }
          },
          "condition_search_hits": {
            "type": "array",
            "description": "키움 조건식 실시간 편입 이력 (보조 센서)",
            "items": {
              "type": "string"
            }
          },
          "channels": {
            "type": "array",
            "description": "이 종목을 올린 채널. briefing | momentum | flow",
            "items": {
              "type": "string",
              "enum": [
                "briefing",
                "momentum",
                "flow"
              ]
            }
          },
          "news": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/newsItem"
            },
            "description": "최근 뉴스. Arm 1·2 **양쪽에 똑같이** 실린다 — 뉴스는 봉투이고 브리핑이 측정 대상이다"
          },
          "disclosures": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/disclosureItem"
            },
            "description": "최근 공시. 뉴스와 같은 이유로 전 arm 공통이다"
          }
        }
      }
    },
    "briefings": {
      "type": "array",
      "description": "이 판단 시점에 유효한 브리핑의 축약본. 최신순. 원문 섹션(sections)과 관점 원문(raw)은 넣지 않는다 — 팩이 수만 토큰으로 부풀고 AI의 주의가 분산된다. 원문이 필요하면 briefings 테이블을 별도 조회한다.",
      "items": {
        "type": "object",
        "required": [
          "briefing_id",
          "kind",
          "published_at",
          "is_fresh"
        ],
        "additionalProperties": false,
        "properties": {
          "briefing_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "market": {
            "type": "string",
            "enum": [
              "KR",
              "US",
              "GLOBAL"
            ]
          },
          "is_fresh": {
            "type": "boolean",
            "description": "이번 사이클에 새로 반영된 브리핑인가. AI가 무엇이 새 정보인지 알아야 같은 판단을 반복하지 않는다."
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "parse_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stance"
              ],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9][0-9A-Z]{5}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "market": {
                  "type": "string",
                  "enum": [
                    "KR",
                    "US"
                  ]
                },
                "stance": {
                  "type": "string",
                  "enum": [
                    "주목",
                    "조건부",
                    "경계",
                    "회피"
                  ]
                },
                "stance_inherited": {
                  "type": "boolean"
                },
                "confidence": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "상",
                        "중상",
                        "중",
                        "중하",
                        "하"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "catalyst": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "invalidation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "check_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kr_links": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "recent_decisions": {
      "type": "array",
      "description": "최근 판단 이력. AI가 자기 판단의 일관성과 최근 오판을 인지하도록 한다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "code": {
            "$ref": "#/$defs/stockCode"
          },
          "action": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "outcome_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "description": "AI가 반드시 지켜야 하는 한도. 실행 계층이 동일한 값으로 재검증한다. 값은 전부 AIK_* 환경변수로만 주입되며 기본값이 없다 (ADR 0004).",
      "required": [
        "max_positions",
        "max_new_entries_this_cycle",
        "max_weight_pct_per_name",
        "max_weight_pct_per_sector",
        "max_risk_pct_per_trade",
        "daily_loss_limit_krw",
        "max_order_vs_adv_pct",
        "max_entry_gap_up_atr",
        "max_entry_gap_down_atr",
        "allowed_entry_types"
      ],
      "additionalProperties": false,
      "properties": {
        "max_positions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_new_entries_this_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "max_weight_pct_per_name": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 50.0
        },
        "max_weight_pct_per_sector": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100.0
        },
        "max_risk_pct_per_trade": {
          "type": "number",
          "description": "1회 최대 손실(계좌 대비 %). 포지션 크기 = (총자산 × 이 값) ÷ 손절폭",
          "minimum": 0.01,
          "maximum": 5.0
        },
        "daily_loss_limit_krw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000,
          "description": "일일 손실 한도(원). 0은 '비활성'이며 data_quality 에 경고가 남는다"
        },
        "daily_loss_limit_hit": {
          "type": "boolean"
        },
        "max_order_vs_adv_pct": {
          "type": "number",
          "description": "주문금액 / 20일 평균 거래대금 상한(%). 슬리피지 방어.",
          "minimum": 0.1,
          "maximum": 50.0
        },
        "blocked_codes": {
          "type": "array",
          "description": "당일 손절 등으로 재진입이 금지된 종목",
          "items": {
            "$ref": "#/$defs/stockCode"
          }
        },
        "max_entry_gap_up_atr": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5.0,
          "description": "진입 허용 상방 갭 (ATR 배수). **봉투다 — AI 가 고르는 값이 아니라 실행 계층이 강제한다** (ADR 0009). 시가가 전일 종가 대비 이 밴드를 벗어나면 진입 지시를 집행하지 않고 이벤트 재판단으로 돌린다. 팩에 싣는 이유는 ADR 0003 원칙 1 이다 — **팩에 없는 것은 AI 에게 없다.** 집행되지 않을 진입을 AI 가 계속 내면 그것이 낭비다.\\n\\n**고정 % 가 아니라 ATR 배수다.** ATR 4% 종목과 13% 종목에 같은 잣대를 대면 안 된다 — 삼화콘덴서 갭 −2.81% 는 ATR 9.9% 의 0.28배지만, 같은 −2.81% 가 ATR 4% 종목에서는 0.70배다."
        },
        "max_entry_gap_down_atr": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5.0,
          "description": "진입 허용 하방 갭 (ATR 배수). 위와 같은 규칙이며 아래쪽 밴드다."
        },
        "allowed_entry_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT",
              "COND"
            ]
          },
          "minItems": 1,
          "description": "**집행 계층이 실제로 낼 수 있는 진입 방식.** 여기 없는 것을 고르면 게이트가 차단하고 그 결정은 버려진다.\\n\\n`COND` 는 조건이 충족되면 진입하는 방식인데 **그 조건을 감시할 실시간 코드(블록 G)가 0줄**이라 지금은 낼 수 없다 — 모의계좌라도 같다. 위험이 없는 것과 판정할 수 없는 것은 다르다: 조건을 못 보면 언제 들어갔는지도, 왜 안 들어갔는지도 기록에 남지 않는다.\\n\\n팩에 싣는 이유는 [ADR 0003](../docs/adr/0003-ai-decides-last.md) 원칙 1 이다 — **팩에 없는 것은 AI 에게 없다.** 집행되지 않을 진입을 계속 내는 것이 낭비다. 실측(2026-09-02): 이것이 없어서 엔진이 SK이노베이션을 `COND` 로 냈고 게이트가 차단했다."
        }
      }
    },
    "data_quality": {
      "type": "object",
