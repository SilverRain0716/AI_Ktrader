# 이 파일을 .env로 복사해 값을 채운다. .env는 절대 커밋하지 않는다.
# 운영 시에는 파일 대신 OS 자격증명 저장소 또는 시크릿 매니저 사용을 권장한다.

# ── 키움 REST API ──────────────────────────────────────
# https://openapi.kiwoom.com 에서 발급. 실전/모의 키가 다르다.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=
# real | mock
KIWOOM_ENV=mock
# 실전 https://api.kiwoom.com / 모의 https://mockapi.kiwoom.com
KIWOOM_REST_BASE=https://mockapi.kiwoom.com
# 실전 wss://api.kiwoom.com:10000 / 모의 wss://mockapi.kiwoom.com:10000
KIWOOM_WS_URL=wss://mockapi.kiwoom.com:10000/api/dostk/websocket

# ── DART OpenAPI ───────────────────────────────────────
# https://opendart.fss.or.kr — 1일 20,000건
DART_API_KEY=

# ── KRX (선택) ─────────────────────────────────────────
# 2025-12-26부터 data.krx.co.kr은 로그인 필수. pykrx 사용 시 필요.
# 개인 계정 자동 로그인은 약관 회색지대이므로 사용 전 검토할 것.
KRX_ID=
KRX_PW=
# https://openapi.krx.co.kr — 1키당 1일 10,000회, 비상업 이용 한정
KRX_OPENAPI_KEY=

# ── 브리핑 저장소 (GitLab) ─────────────────────────────
# 브리핑 .md 가 쌓이는 저장소. read_repository 권한만 있으면 된다.
BRIEFING_GITLAB_TOKEN=
BRIEFING_GITLAB_PROJECT=SilverRain0716/briefings

# ── AI 판단 엔진 ───────────────────────────────────────
# ── AI 판단 엔진 (ADR 0007) ────────────────────────────
# 제공자는 갈아끼울 수 있지만 **페이퍼 기간 중에는 바꾸지 않는다** — 모델 교체와 같은 급의
# 함수 변경이라 F2·F3 표본이 (provider, model, prompt_id) 층으로 갈리고 시계가 다시 간다.
# 쓰는 쪽 키만 채우면 된다.
AIK_LLM_PROVIDER=anthropic      # anthropic | openai
AIK_LLM_MODEL=                  # 비우면 제공자 기본값 (anthropic: claude-opus-5 / openai: gpt-5.6)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 알림 ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 리스크 한도 (필수) ─────────────────────────────────
# 기본값이 없다. 하나라도 비어 있으면 컨텍스트 팩 생성이 거부된다.
# 저장소에 커밋하지 않는다 (ADR 0004) — 그래서 여기에는 값을 적지 않는다.
# 범위를 벗어나거나 숫자가 아니면 에러다. 조용히 넘어가지 않는다.
#
# 동시 보유 종목 수 (1~20)
AIK_MAX_POSITIONS=
# 한 사이클에 새로 진입할 수 있는 종목 수 (0~10). 0이면 신규 진입 없음
AIK_MAX_NEW_ENTRIES_PER_CYCLE=
# 종목당 비중 상한, % (0.1~50). 균등 배분이면 100 ÷ 종목수 근처가 기준이 된다
# 섹터 상한보다 크면 거부된다 — 한 종목이 자기 섹터에 들어가지 못하는 설정이기 때문
AIK_MAX_WEIGHT_PCT_PER_NAME=
# 섹터당 비중 상한, % (0.1~100)
AIK_MAX_WEIGHT_PCT_PER_SECTOR=
# 1회 매매의 최대 손실, 계좌 대비 % (0.01~5)
# 포지션 크기 = (총자산 × 이 값) ÷ 손절폭. 0.5면 손절 시 계좌의 0.5%를 잃는다
AIK_MAX_RISK_PCT_PER_TRADE=
# 일일 손실 한도, 원 (0~100억). 도달하면 신규 진입이 차단된다
# 0 은 '한도 없음'이며, 팩의 data_quality 에 경고로 남는다
AIK_DAILY_LOSS_LIMIT_KRW=
# 주문금액 / 20일 평균 거래대금 상한, % (0.1~50). 슬리피지 방어
AIK_MAX_ORDER_VS_ADV_PCT=

# ── 페이퍼 계좌 (필수) ─────────────────────────────────
# 페이퍼 시드, 원 (100만~1000억). 가상 자금이어도 자금 규모이므로 커밋하지 않는다.
# 실제 운용할 금액과 같은 값을 넣어라 — 다르면 비중·손절폭 계산이 실제와 어긋난다.
AIK_PAPER_EQUITY_KRW=

# ── 진입 봉투 (ADR 0009) ───────────────────────────────
# **ATR 배수다. 고정 % 가 아니다** — ATR 4% 종목과 13% 종목에 같은 잣대를 대면 안 된다.
# 시가가 전일 종가 대비 이 배수를 넘게 벌어지면 진입 지시를 집행하지 않고
# 이벤트 재판단으로 돌린다. 값은 실험 2(갭 가드 임계)가 정한다 — 지금은 미정이다.
AIK_MAX_ENTRY_GAP_UP_ATR=
AIK_MAX_ENTRY_GAP_DOWN_ATR=

# ── 실행 제어 ──────────────────────────────────────────
# paper | mock | live  — live는 Phase 7까지 사용 금지
EXECUTION_MODE=paper
# true면 모든 주문이 즉시 차단된다. 사고 시 이 값을 true로.
KILL_SWITCH=false

# ── 집행 게이트 (gate/) ─────────────────────────────────
# 주문이 나가도 되는지 판정한다. **주문 코드 자체는 아직 없다.**
#
# EXECUTION_MODE  paper = 판정만 하고 주문을 내지 않는다 (기본값이자 안전값)
#                 mock  = 키움 모의투자 서버로 주문
#                 live  = 실계좌. AIK_LIVE_ACK 승인이 함께 있어야 한다
# **모드와 KIWOOM_ENV 가 어긋나면 게이트가 막는다** — mock 인데 KIWOOM_ENV=real 이면
# 모의투자를 한다면서 실전 서버로 주문이 나간다.
EXECUTION_MODE=paper

# 켜면 모든 집행이 차단된다. **해석할 수 없는 값은 '켜짐'으로 본다.**
KILL_SWITCH=false
# 이 파일이 존재해도 차단된다. 환경변수는 프로세스 시작 시 고정되므로,
# **돌고 있는 배치를 멈추려면 파일 쪽이 필요하다.**
# 기본 경로는 <데이터 디렉터리>/KILL
AIK_KILL_FILE=

# 실계좌 모드에서만 필요하다. 정확히 I_UNDERSTAND 여야 한다.
AIK_LIVE_ACK=
